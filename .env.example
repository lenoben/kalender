# Server Configuration
PORT=8080
ENV=development

# Database Connection (Supabase PostgreSQL or Local Postgres)
# Local Postgres format: postgres://postgres:postgres@localhost:5432/calendar_db?sslmode=disable
# Supabase format: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/calendar_db?sslmode=disable

# Security & Admin Authentication
ADMIN_PASSWORD=adminsecret123
SESSION_SECRET=super-secret-key-32-chars-min-len!!
